<Window x:Class="GerenciamentoLoja.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:GerenciamentoLoja.ViewModels"
        xmlns:views="clr-namespace:GerenciamentoLoja.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:ShellViewModel}"
        Title="Gerenciamento da Loja" Height="720" Width="1200"
        WindowStartupLocation="CenterScreen"
        FontFamily="{materialDesign:MaterialDesignFont}"
        TextElement.FontSize="14">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardPlaceholderViewModel}">
            <views:DashboardPlaceholderView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConexaoPlanilhaViewModel}">
            <views:ConexaoPlanilhaView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProdutosDisponiveisViewModel}">
            <views:ProdutosDisponiveisView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VendasRealizadasViewModel}">
            <views:VendasRealizadasView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdicionarVendaViewModel}">
            <views:AdicionarVendaView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BalancoGeralViewModel}">
            <views:BalancoGeralView/>
        </DataTemplate>

        <Style x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="4"/>
        </Style>

        <Style x:Key="NavSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#8AAAAAAA"/>
            <Setter Property="Margin" Value="12,10,0,2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <materialDesign:ColorZone Grid.Column="0" Mode="PrimaryDark">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,16,16,12">
                    <TextBlock Text="Gerenciamento da Loja" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Foreground="White" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="8,4,8,12">
                    <Separator Margin="4,0,4,4"/>
                    <Button Content="Conexão com a planilha" Command="{Binding NavegarParaConexaoCommand}"
                            Style="{StaticResource NavButtonStyle}"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,0">
                        <Button Content="Dashboard" Command="{Binding NavegarParaDashboardCommand}"
                                Style="{StaticResource NavButtonStyle}"/>

                        <TextBlock Text="PRODUTOS" Style="{StaticResource NavSectionHeaderStyle}"/>
                        <Button Content="Produtos disponíveis" Command="{Binding NavegarParaProdutosCommand}"
                                Style="{StaticResource NavButtonStyle}"/>

                        <TextBlock Text="VENDAS" Style="{StaticResource NavSectionHeaderStyle}"/>
                        <Button Content="Vendas realizadas" Command="{Binding NavegarParaVendasRealizadasCommand}"
                                Style="{StaticResource NavButtonStyle}"/>
                        <Button Content="Adicionar venda" Command="{Binding NavegarParaAdicionarVendaCommand}"
                                Style="{StaticResource NavButtonStyle}"/>

                        <TextBlock Text="FINANCEIRO" Style="{StaticResource NavSectionHeaderStyle}"/>
                        <Button Content="Balanço geral" Command="{Binding NavegarParaBalancoCommand}"
                                Style="{StaticResource NavButtonStyle}"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </materialDesign:ColorZone>

        <DockPanel Grid.Column="1">
            <materialDesign:ColorZone DockPanel.Dock="Top" Mode="PrimaryMid" Padding="24,14">
                <TextBlock Text="{Binding TituloPagina}" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Foreground="White"/>
            </materialDesign:ColorZone>

            <ContentControl Content="{Binding CurrentViewModel}"/>
        </DockPanel>
    </Grid>
</Window>
