<UserControl x:Class="GerenciamentoLoja.Views.VendasRealizadasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:GerenciamentoLoja.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:VendasRealizadasViewModel}"
             d:DesignWidth="900" d:DesignHeight="700">
    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" Text="Vendas realizadas" Style="{StaticResource MaterialDesignHeadline5TextBlock}" Margin="0,0,0,8"/>

        <TextBlock DockPanel.Dock="Top" Text="{Binding Mensagem}" Margin="0,0,0,16"
                   Visibility="{Binding Mensagem, Converter={StaticResource StringToVisibilityConverter}}"
                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>

        <TextBlock DockPanel.Dock="Bottom" Margin="0,16,0,0" Style="{StaticResource MaterialDesignSubtitle1TextBlock}">
            <Run Text="Total vendido: "/>
            <Run Text="{Binding TotalVendas, StringFormat={}{0:C2}, Mode=OneWay}" FontWeight="Bold"/>
        </TextBlock>

        <DataGrid ItemsSource="{Binding Vendas}" AutoGenerateColumns="False" IsReadOnly="True"
                  materialDesign:DataGridAssist.CellPadding="8" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Data da venda" Binding="{Binding DataVenda, StringFormat={}{0:dd/MM/yyyy}}" Width="130"/>
                <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="100"/>
                <DataGridTextColumn Header="Produto" Binding="{Binding Produto}" Width="*"/>
                <DataGridTextColumn Header="Categoria" Binding="{Binding Categoria}" Width="140"/>
                <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="160"/>
                <DataGridTextColumn Header="Valor recebido" Binding="{Binding ValorRecebido, StringFormat={}{0:C2}}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
