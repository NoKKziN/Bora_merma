<UserControl x:Class="GerenciamentoLoja.Views.ProdutosDisponiveisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:GerenciamentoLoja.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ProdutosDisponiveisViewModel}"
             d:DesignWidth="1050" d:DesignHeight="700">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="Produtos disponíveis" Style="{StaticResource MaterialDesignHeadline5TextBlock}" Margin="0,0,0,16"/>

            <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding FiltroCategoria, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Filtrar por categoria" Margin="0,0,8,0"/>
                <Button Grid.Column="1" Content="Filtrar" Command="{Binding FiltrarCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0"/>
                <Button Grid.Column="2" Content="Dar baixa" Command="{Binding DarBaixaCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"/>
            </Grid>

            <TextBlock DockPanel.Dock="Top" Text="{Binding Mensagem}" Margin="0,0,0,16"
                       Visibility="{Binding Mensagem, Converter={StaticResource StringToVisibilityConverter}}"
                       Foreground="{DynamicResource MaterialDesignBodyLight}"/>

            <DataGrid ItemsSource="{Binding Itens}" SelectedItem="{Binding ItemSelecionado}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      materialDesign:DataGridAssist.CellPadding="8" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="110"/>
                    <DataGridTextColumn Header="Produto" Binding="{Binding Produto}" Width="*"/>
                    <DataGridTextColumn Header="Categoria" Binding="{Binding Categoria}" Width="150"/>
                    <DataGridTextColumn Header="Entrada" Binding="{Binding DataEntrada, StringFormat={}{0:dd/MM/yyyy}}" Width="100"/>
                    <DataGridTextColumn Header="Preço à vista" Binding="{Binding PrecoAVista, StringFormat={}{0:C2}}" Width="110"/>
                    <DataGridTextColumn Header="Preço cartão" Binding="{Binding PrecoCartao, StringFormat={}{0:C2}}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <materialDesign:Card Grid.Column="2" Padding="16" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Registrar entrada de peça" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Margin="0,0,0,12"/>

                <TextBox Text="{Binding SkuEntrada, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="SKU" Margin="0,0,0,12"/>
                <TextBox Text="{Binding ProdutoEntrada, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Nome do produto" Margin="0,0,0,12"/>
                <TextBox Text="{Binding CategoriaEntrada, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Categoria" Margin="0,0,0,12"/>
                <TextBox Text="{Binding ValorCustoEntrada, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Valor de custo" Margin="0,0,0,12"/>
                <TextBox Text="{Binding PrecoAVistaEntrada, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Preço à vista" Margin="0,0,0,12"/>
                <TextBox Text="{Binding PrecoCartaoEntrada, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Preço no cartão" Margin="0,0,0,16"/>

                <Button Content="Registrar entrada" Command="{Binding RegistrarEntradaCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}" HorizontalAlignment="Left"/>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>
