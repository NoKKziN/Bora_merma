<UserControl x:Class="GerenciamentoLoja.Views.AdicionarVendaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:GerenciamentoLoja.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AdicionarVendaViewModel}"
             d:DesignWidth="700" d:DesignHeight="700">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <materialDesign:Card MaxWidth="520" HorizontalAlignment="Left" Padding="24">
            <StackPanel>
                <TextBlock Text="Adicionar venda" Style="{StaticResource MaterialDesignHeadline5TextBlock}" Margin="0,0,0,16"/>

                <TextBox Text="{Binding Sku, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="SKU" Margin="0,0,0,12"/>
                <TextBox Text="{Binding Produto, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Nome do produto" Margin="0,0,0,12"/>
                <TextBox Text="{Binding Categoria, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Categoria" Margin="0,0,0,12"/>
                <TextBox Text="{Binding Cliente, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Cliente (opcional)" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding Quantidade, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Quantidade"/>
                    <TextBox Grid.Column="2" Text="{Binding ValorUnitario, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Valor unitário"/>
                </Grid>

                <TextBlock Margin="0,0,0,16" Style="{StaticResource MaterialDesignSubtitle1TextBlock}">
                    <Run Text="Total da venda: "/>
                    <Run Text="{Binding Total, StringFormat={}{0:C2}, Mode=OneWay}" FontWeight="Bold"/>
                </TextBlock>

                <TextBlock Text="{Binding Mensagem}" Margin="0,0,0,12"
                           Visibility="{Binding Mensagem, Converter={StaticResource StringToVisibilityConverter}}"
                           Foreground="{DynamicResource MaterialDesignBodyLight}"/>

                <Button Content="Registrar venda" Command="{Binding RegistrarVendaCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}" HorizontalAlignment="Left"/>
            </StackPanel>
        </materialDesign:Card>
    </ScrollViewer>
</UserControl>
