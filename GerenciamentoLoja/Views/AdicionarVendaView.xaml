<UserControl x:Class="GerenciamentoLoja.Views.AdicionarVendaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:GerenciamentoLoja.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AdicionarVendaViewModel}"
             d:DesignWidth="700" d:DesignHeight="700">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <materialDesign:Card MaxWidth="560" HorizontalAlignment="Left" Padding="24">
            <StackPanel>
                <TextBlock Text="Adicionar venda" Style="{StaticResource MaterialDesignHeadline5TextBlock}" Margin="0,0,0,16"/>

                <TextBlock Text="{Binding Mensagem}" Margin="0,0,0,12"
                           Visibility="{Binding Mensagem, Converter={StaticResource StringToVisibilityConverter}}"
                           Foreground="{DynamicResource MaterialDesignBodyLight}"/>

                <ComboBox ItemsSource="{Binding ItensDisponiveis}" SelectedItem="{Binding ItemSelecionado}"
                          materialDesign:HintAssist.Hint="Peça em estoque" Margin="0,0,0,16">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="{Binding Sku, Mode=OneWay}"/>
                                <Run Text=" - "/>
                                <Run Text="{Binding Produto, Mode=OneWay}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="{Binding ItemSelecionado.Categoria, StringFormat=Categoria: {0}}"/>
                    <TextBlock Text="{Binding ItemSelecionado.PrecoAVista, StringFormat=Preço à vista sugerido: {0:C2}}"/>
                </StackPanel>

                <TextBox Text="{Binding ValorRecebido, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Valor recebido" Margin="0,0,0,12"/>
                <TextBox Text="{Binding Cliente, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Cliente (opcional)" Margin="0,0,0,16"/>

                <Button Content="Registrar venda" Command="{Binding RegistrarVendaCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}" HorizontalAlignment="Left"/>
            </StackPanel>
        </materialDesign:Card>
    </ScrollViewer>
</UserControl>
