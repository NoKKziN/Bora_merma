<UserControl x:Class="GerenciamentoLoja.Views.ConexaoPlanilhaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:GerenciamentoLoja.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ConexaoPlanilhaViewModel}"
             d:DesignWidth="800" d:DesignHeight="600">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="Conectar com a planilha da loja" Style="{StaticResource MaterialDesignHeadline5TextBlock}" Margin="0,0,0,8"/>
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,24">
                Selecione o arquivo .xlsx da loja, escolha a aba e informe qual coluna corresponde a cada campo.
                A planilha permanece aberta no Excel e qualquer alteração feita por aqui ou por lá é sincronizada em tempo real.
            </TextBlock>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding CaminhoArquivo, Mode=OneWay}" IsReadOnly="True"
                         materialDesign:HintAssist.Hint="Arquivo selecionado" Margin="0,0,8,0"/>
                <Button Grid.Column="1" Content="Selecionar arquivo..." Command="{Binding SelecionarArquivoCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"/>
            </Grid>

            <ComboBox ItemsSource="{Binding AbasDisponiveis}" SelectedItem="{Binding AbaSelecionada}"
                      materialDesign:HintAssist.Hint="Aba da planilha" Margin="0,0,0,16"/>

            <TextBox Text="{Binding LinhaCabecalho, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="Linha do cabeçalho (ex: 1)" Margin="0,0,0,16" MaxWidth="220" HorizontalAlignment="Left"/>

            <TextBlock Text="Mapeamento de colunas" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Margin="0,8,0,8"/>

            <ItemsControl ItemsSource="{Binding Campos}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ComboBox ItemsSource="{Binding Opcoes}" SelectedItem="{Binding ColunaSelecionada}"
                                  materialDesign:HintAssist.Hint="{Binding Rotulo}"
                                  Margin="0,0,0,12"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding Mensagem}" Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
                       TextWrapping="Wrap" Margin="0,8,0,8"
                       Visibility="{Binding Mensagem, Converter={StaticResource StringToVisibilityConverter}}"/>

            <Button Content="Conectar" Command="{Binding ConectarCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    HorizontalAlignment="Left" Margin="0,8,0,0"/>

            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,16,0,0"
                         Visibility="{Binding Carregando, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
