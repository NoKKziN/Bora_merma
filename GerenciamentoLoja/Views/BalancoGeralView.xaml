<UserControl x:Class="GerenciamentoLoja.Views.BalancoGeralView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:GerenciamentoLoja.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:BalancoGeralViewModel}"
             d:DesignWidth="900" d:DesignHeight="700">
    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" Text="Balanço geral" Style="{StaticResource MaterialDesignHeadline5TextBlock}" Margin="0,0,0,16"/>

        <ComboBox DockPanel.Dock="Top" ItemsSource="{Binding Agrupamentos}" SelectedItem="{Binding AgrupamentoSelecionado}"
                  materialDesign:HintAssist.Hint="Agrupar por" Width="220" HorizontalAlignment="Left" Margin="0,0,0,16"/>

        <TextBlock DockPanel.Dock="Top" Text="{Binding Mensagem}" Margin="0,0,0,16"
                   Visibility="{Binding Mensagem, Converter={StaticResource StringToVisibilityConverter}}"
                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>

        <UniformGrid DockPanel.Dock="Bottom" Columns="3" Margin="0,16,0,0">
            <materialDesign:Card Padding="16" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Entradas (vendas)" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                    <TextBlock Text="{Binding TotalEntradas, StringFormat={}{0:C2}}" Style="{StaticResource MaterialDesignHeadline6TextBlock}"/>
                </StackPanel>
            </materialDesign:Card>
            <materialDesign:Card Padding="16" Margin="8,0,8,0">
                <StackPanel>
                    <TextBlock Text="Saídas (compras/reposição)" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                    <TextBlock Text="{Binding TotalSaidas, StringFormat={}{0:C2}}" Style="{StaticResource MaterialDesignHeadline6TextBlock}"/>
                </StackPanel>
            </materialDesign:Card>
            <materialDesign:Card Padding="16" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="Saldo" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                    <TextBlock Text="{Binding SaldoTotal, StringFormat={}{0:C2}}" Style="{StaticResource MaterialDesignHeadline6TextBlock}"/>
                </StackPanel>
            </materialDesign:Card>
        </UniformGrid>

        <DataGrid ItemsSource="{Binding Periodos}" AutoGenerateColumns="False" IsReadOnly="True"
                  materialDesign:DataGridAssist.CellPadding="8" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Período" Binding="{Binding Periodo}" Width="*"/>
                <DataGridTextColumn Header="Entradas" Binding="{Binding Entradas, StringFormat={}{0:C2}}" Width="140"/>
                <DataGridTextColumn Header="Saídas" Binding="{Binding Saidas, StringFormat={}{0:C2}}" Width="140"/>
                <DataGridTextColumn Header="Saldo" Binding="{Binding Saldo, StringFormat={}{0:C2}}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
